{% extends 'base.html.twig' %}

{% block title %}Détails du groupe{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Détails du groupe</h1>

        <div class="card mb-4">
            <div class="card-header">
                <h2>{{ group.name }}</h2>
            </div>
            <div class="card-body">
                <h3>Utilisateurs du groupe</h3>
                <ul class="list-group">
                {% for user in group.users %}
                    <li class="list-group-item">{{ user.email }}</li>
                {% else %}
                    <li class="list-group-item">Aucun utilisateur dans ce groupe</li>
                {% endfor %}
                </ul>
            </div>
            <div class="card-footer">
                <a href="{{ path('app_group_edit', {'id': group.id}) }}" class="btn btn-warning">Modifier</a>
                <a href="{{ path('app_group_index') }}" class="btn btn-secondary">Retour à la liste</a>
                <form method="post" action="{{ path('app_group_delete', {'id': group.id}) }}" style="display: inline-block" 
                      data-controller="confirm"
                      data-action="submit->confirm#onSubmit"
                      data-confirm-message-value="Êtes-vous sûr de vouloir supprimer ce groupe?">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ group.id) }}">
                    <button class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i> Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}