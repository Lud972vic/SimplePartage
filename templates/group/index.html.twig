{% extends 'base.html.twig' %}

{% block title %}Gestion des groupes{% endblock %}

{% block body %}
    <div class="container">
        <!-- Fil d'Ariane -->
        <nav aria-label="breadcrumb" class="mt-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_folder_index') }}"><i class="bi bi-house-door"></i> Accueil</a></li>
                <li class="breadcrumb-item active" aria-current="page"><i class="bi bi-people-fill"></i> Gestion des groupes</li>
            </ol>
        </nav>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h2 mb-0"><i class="bi bi-people-fill me-2"></i>Gestion des groupes</h1>
            <a href="{{ path('app_group_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Nouveau groupe
            </a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                <i class="bi bi-check-circle me-2"></i>{{ message }}
            </div>
        {% endfor %}

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0"><i class="bi bi-list-ul me-2"></i>Liste des groupes</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">ID</th>
                                <th>Nom</th>
                                <th>Utilisateurs</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for group in groups %}
                            <tr>
                                <td class="ps-3">{{ group.id }}</td>
                                <td>
                                    <span class="fw-medium">{{ group.name }}</span>
                                </td>
                                <td>
                                    <span class="badge bg-info rounded-pill">{{ group.users|length }}</span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group">
                                        <a href="{{ path('app_group_show', {'id': group.id}) }}" class="btn btn-sm btn-outline-primary" title="Voir">
                                            <i class="bi bi-eye"></i> Voir
                                        </a>
                                        <a href="{{ path('app_group_edit', {'id': group.id}) }}" class="btn btn-sm btn-outline-warning" title="Modifier">
                                            <i class="bi bi-pencil"></i> Modifier
                                        </a>
                                        <form method="post" action="{{ path('app_group_delete', {'id': group.id}) }}" style="display: inline-block" 
                                              data-controller="confirm"
                                              data-action="submit->confirm#onSubmit"
                                              data-confirm-message-value="Êtes-vous sûr de vouloir supprimer ce groupe?">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ group.id) }}">
                                            <button class="btn btn-sm btn-outline-danger" title="Supprimer">
                                                <i class="bi bi-trash"></i> Supprimer
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center py-4">
                                    <i class="bi bi-exclamation-circle text-muted me-2"></i>Aucun groupe trouvé
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}