{% extends 'base.html.twig' %}

{% block title %}Créer un nouveau groupe{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header">
            <h1>Créer un nouveau groupe</h1>
        </div>
        <div class="card-body">
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn btn-primary mt-3">Enregistrer</button>
            {{ form_end(form) }}

            <a href="{{ path('app_group_index') }}" class="btn btn-secondary mt-3">Retour à la liste</a>
        </div>
    </div>
{% endblock %}