{% extends 'base.html.twig' %}

{% block title %}SimplePartage - Dossiers{% endblock %}

{% block body %}
    <!-- Fil d'Ariane -->
    <nav aria-label="breadcrumb" class="mt-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item active" aria-current="page"><i class="bi bi-house-door"></i> Accueil</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2"><i class="bi bi-folder me-2"></i> Vos dossiers</h1>
        <a href="{{ path('app_folder_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Nouveau dossier
        </a>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-folder-open text-primary me-2"></i>
                        Dossiers racines
                    </h5>
                    <span class="badge bg-light text-primary">{{ folders|length }} dossier(s)</span>
                </div>
                <div class="card-body p-0">
                    {% if folders|length > 0 %}
                        <div class="list-group list-group-flush">
                            {% for folder in folders %}
                                <div class="list-group-item list-group-item-action border-0 py-3 px-4">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <a href="{{ path('app_folder_show', {'id': folder.id}) }}" class="text-decoration-none text-dark d-flex align-items-center">
                                            <div class="folder-icon me-3">
                                                <i class="fas fa-folder text-primary fa-lg"></i>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-semibold">{{ folder.name }}</h6>
                                                <small class="text-muted">Créé le: {{ folder.createdAt|date('d/m/Y') }}</small>
                                            </div>
                                        </a>
                                        <div>
                                            <span class="badge bg-primary rounded-pill me-2">{{ folder.files|length }} fichier(s)</span>
                                            {% if is_granted('ROLE_ADMIN') %}
                                                <form method="post" action="{{ path('app_folder_delete', {'id': folder.id}) }}" style="display: inline-block"
                                                      data-controller="confirm"
                                                      data-action="submit->confirm#onSubmit"
                                                      data-confirm-message-value="Êtes-vous sûr de vouloir supprimer ce dossier et tout son contenu?">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ folder.id) }}">
                                                    <button class="btn btn-sm btn-outline-danger" title="Supprimer">
                                                        <i class="bi bi-trash"></i> Supprimer
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-5">
                            <i class="fas fa-folder-open text-muted fa-3x mb-3"></i>
                            <p class="text-muted">Aucun dossier accessible.</p>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="#" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-plus-circle me-1"></i> Créer un dossier
                                </a>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>
            <div class="card">
                <div class="card-header py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="fas fa-chart-pie text-primary me-2"></i>
                        Statistiques
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <span>Dossiers & Sous-dossiers</span>
                        <span class="fw-bold">{{ totalFolderCount }}</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Fichiers</span>
                        <span class="fw-bold">{{ totalFileCount }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}